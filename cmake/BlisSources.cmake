# Source collection + object-library construction. Replaces the
# gen-make-frags/mirror-tree machinery: sources are globbed from the source
# tree (CONFIGURE_DEPENDS re-globs on rebuild), skipping the same directory
# ignore-list as the fragment generator.

set(BLIS_FRAGMENT_IGNORE_DIRS attic broken old other temp tmp test p10_testsuite)

# blis_collect(<out> <root> <suffix1> [suffix2 ...])
# Recursively collects files with the given suffixes under <root>, skipping
# ignored directories. Paths returned absolute.
function(blis_collect out root)
  set(all "")
  foreach(suf ${ARGN})
    file(GLOB_RECURSE found CONFIGURE_DEPENDS "${root}/*.${suf}")
    list(APPEND all ${found})
  endforeach()
  set(keep "")
  foreach(f ${all})
    file(RELATIVE_PATH rel "${root}" "${f}")
    set(skip FALSE)
    foreach(ig ${BLIS_FRAGMENT_IGNORE_DIRS})
      if(rel MATCHES "(^|/)${ig}(/|$)")
        set(skip TRUE)
        break()
      endif()
    endforeach()
    if(NOT skip)
      list(APPEND keep "${f}")
    endif()
  endforeach()
  set(${out} ${keep} PARENT_SCOPE)
endfunction()

# Directories containing header files under <root> (deduped) — used both for
# flatten-headers.py's search list and for -I flags.
function(blis_header_dirs out)
  set(dirs "")
  foreach(root ${ARGN})
    foreach(suf h hh hpp hxx)
      file(GLOB_RECURSE hdrs CONFIGURE_DEPENDS "${root}/*.${suf}")
      foreach(h ${hdrs})
        file(RELATIVE_PATH rel "${root}" "${h}")
        set(skip FALSE)
        foreach(ig ${BLIS_FRAGMENT_IGNORE_DIRS})
          if(rel MATCHES "(^|/)${ig}(/|$)")
            set(skip TRUE)
            break()
          endif()
        endforeach()
        if(skip)
          continue()
        endif()
        get_filename_component(d "${h}" DIRECTORY)
        list(APPEND dirs "${d}")
      endforeach()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES dirs)
  set(${out} ${dirs} PARENT_SCOPE)
endfunction()

# Adds an OBJECT library with the right flags/dependencies.
# blisadd_objects(<name> CONFIG <cfg> CLASS <class> SOURCES <files...>
#                 [EXTRA_INCLUDES <dirs...>])
function(blis_add_objects name)
  cmake_parse_arguments(ARG "" "CONFIG;CLASS" "SOURCES;EXTRA_INCLUDES" ${ARGN})
  if(NOT ARG_SOURCES)
    return()
  endif()
  blis_get_cflags("${ARG_CONFIG}" "${ARG_CLASS}" _cflags)
  add_library(${name} OBJECT ${ARG_SOURCES})
  foreach(flag IN LISTS _cflags)
    target_compile_options(${name} PRIVATE "$<$<COMPILE_LANGUAGE:C>:${flag}>")
  endforeach()
  set(_has_cxx FALSE)
  foreach(src ${ARG_SOURCES})
    if(src MATCHES "\\.(cc|cpp|cxx)$")
      set(_has_cxx TRUE)
    endif()
  endforeach()
  if(_has_cxx)
    blis_get_cxxflags("${ARG_CONFIG}" "${ARG_CLASS}" _cxxflags)
    foreach(flag IN LISTS _cxxflags)
      target_compile_options(${name} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${flag}>")
    endforeach()
  endif()
  target_include_directories(${name} PRIVATE
    "${PROJECT_BINARY_DIR}/include" ${BLIS_CINCDIRS} ${ARG_EXTRA_INCLUDES})
  add_dependencies(${name} blis_flat_headers)
  # .s/.S go through the C compiler driver like make's kernels rule. The -x
  # flags mirror gcc's extension dispatch (.S preprocessed, .s not) because
  # LANGUAGE C makes CMake inject -x c.
  foreach(src ${ARG_SOURCES})
    if(src MATCHES "\\.S$")
      set_source_files_properties(${src} PROPERTIES LANGUAGE C COMPILE_OPTIONS "-x;assembler-with-cpp")
    elseif(src MATCHES "\\.s$")
      set_source_files_properties(${src} PROPERTIES LANGUAGE C COMPILE_OPTIONS "-x;assembler")
    endif()
  endforeach()
  set_property(GLOBAL APPEND PROPERTY BLIS_OBJLIBS ${name})
endfunction()
